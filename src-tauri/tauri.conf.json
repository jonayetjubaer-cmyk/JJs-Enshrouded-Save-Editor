{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JJ’s Enshrouded Save editor",
  "version": "0.2.0",
  "identifier": "local.jj.enshrouded-save-editor",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "JJ's Enshrouded Save editor",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Jonaex LTD",
    "copyright": "Copyright (c) 2026 Jonaex LTD. Based on work by Nicolas Ferreira (MIT).",
    "shortDescription": "JJ’s Enshrouded Save editor",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
